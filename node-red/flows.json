    {
        "id": "fn1",
        "type": "function",
        "z": "tab1",
        "name": "gerar transacao",
        "func": "var mccs = [\"5411\",\"5541\",\"5812\",\"5912\",\"7995\",\"6011\",\"6051\",\"4829\"];\nfunction pick(a) { return a[Math.floor(Math.random()*a.length)]; }\nvar agora = new Date();\nvar cartao = \"C\" + String(Math.floor(Math.random()*500)+1).padStart(5,\"0\");\nvar valor = Math.round((Math.random()*350+3)*100)/100;\nvar pais = pick([\"PT\",\"PT\",\"PT\",\"ES\",\"FR\",\"BR\"]);\nif (Math.random() < 0.08) { valor *= 4; pais = \"XX\"; }\nmsg.payload = {\n    id: agora.getTime().toString(),\n    ts: agora.toISOString(),\n    cartao: cartao,\n    mcc: pick(mccs),\n    valor: valor,\n    pais: pais\n};\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 340,
