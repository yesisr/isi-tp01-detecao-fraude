      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Valor Total e Sinalizado",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
                      "kind": "DataQuery",
                      "group": "grafana-postgresql-datasource",
                      "version": "v0",
                      "datasource": {
                        "name": "cg1tedumxnqpsf"
                      },
                      "spec": {
                        "dataset": "fraude",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "WITH total AS (\n  SELECT dia, SUM(valor_eur) AS valor_total_eur\n  FROM mart_resumo_diario\n  WHERE $__timeFilter(dia)\n  GROUP BY dia\n),\nsinalizado AS (\n  SELECT s.data_hora::date AS dia,\n         SUM(a.valor_eur) AS valor_sinalizado_eur\n  FROM mart_alertas a\n  JOIN stg_ingestao s USING (id_transacao)\n  WHERE a.score >= 50\n    AND $__timeFilter(s.data_hora)\n  GROUP BY 1\n)\nSELECT total.dia::timestamp AS \"time\",\n       total.valor_total_eur,\n       COALESCE(sinalizado.valor_sinalizado_eur, 0) AS valor_sinalizado_eur\nFROM total\nLEFT JOIN sinalizado USING (dia)\nORDER BY 1;",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
