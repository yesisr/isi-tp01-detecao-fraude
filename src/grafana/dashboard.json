                      "spec": {
                        "dataset": "fraude",
                        "editorMode": "code",
                        "format": "table",
                        "rawQuery": true,
                        "rawSql": "SELECT date_trunc('hour', s.data_hora) AS \"time\",\n       COUNT(*) AS alertas\nFROM mart_alertas a\nJOIN stg_ingestao s USING (id_transacao)\nWHERE $__timeFilter(s.data_hora)\nGROUP BY 1\nORDER BY 1;",
